# ─────────────────────────────────────────────
#  랜덤박스 — 적룡의 보물상자
#  적룡 이그니스를 쓰러뜨리면 근처(40칸) 모든 플레이어에게 1개씩
#  우클릭 → 룰렛이 돌다가 멈추고 보상 지급
# ─────────────────────────────────────────────

options:
    p: &c[보물상자] &f
    title: &c&l🐉 적룡의 보물상자

function boxItem() :: item:
    set {_b} to 1 of chest named colored "&c&l🐉 적룡의 보물상자"
    set lore of {_b} to colored "&7적룡 이그니스가 지키던 보물.", "" and colored "&e우클릭해서 열기"
    enchant {_b} with unbreaking 1
    return {_b}

# 보상 표: 번호 → (표시 아이템, 이름, 확률 가중치)
function boxRoll() :: number:
    set {_r} to random number between 0 and 100
    if {_r} < 40:
        return 1
    if {_r} < 60:
        return 2
    if {_r} < 72:
        return 3
    if {_r} < 82:
        return 4
    if {_r} < 92:
        return 5
    if {_r} < 98:
        return 6
    return 7

function boxIcon(k: number) :: item:
    if {_k} = 1:
        return 1 of gold ingot named colored "&6돈 50,000 ~ 150,000원"
    if {_k} = 2:
        return 1 of amethyst shard named colored "&b별의 조각 10 ~ 20개"
    if {_k} = 3:
        return 1 of paper named colored "&e펫 뽑기권 2 ~ 3장"
    if {_k} = 4:
        return 1 of prismarine shard named colored "&c용의 비늘 2 ~ 4개"
    if {_k} = 5:
        return 1 of diamond sword named colored "&d특수 무기 1개 (무작위)"
    if {_k} = 6:
        return 1 of netherite sword named colored "&c&l적룡 장비 (용린 대검 · 적룡의 활)"
    return 1 of nether star named colored "&6&l대박! 돈 500,000원 + 뽑기권 5장"

function boxGive(p: player, k: number):
    if {_k} = 1:
        set {_m} to random integer between 50000 and 150000
        add {_m} to {_p}'s balance
        send colored "{@p}&6%{_m}%원&f을 얻었어요!" to {_p}
    else if {_k} = 2:
        set {_n} to random integer between 10 and 20
        execute console command "mm items give %{_p}% 별의조각 %{_n}%"
        send colored "{@p}&b별의 조각 %{_n}%개&f를 얻었어요!" to {_p}
    else if {_k} = 3:
        set {_n} to random integer between 2 and 3
        execute console command "starrpg give %{_p}% 뽑기권 %{_n}%"
        send colored "{@p}&e펫 뽑기권 %{_n}%장&f을 얻었어요!" to {_p}
    else if {_k} = 4:
        set {_n} to random integer between 2 and 4
        execute console command "mm items give %{_p}% 용의비늘 %{_n}%"
        send colored "{@p}&c용의 비늘 %{_n}%개&f를 얻었어요!" to {_p}
    else if {_k} = 5:
        set {_pool::*} to "fang_sword", "hound_sword", "harpy_bow", "star_staff", "frost_staff", "lich_staff", "frost_bow", "shadow_dagger" and "venom_dagger"
        set {_id} to random element out of {_pool::*}
        give fResult({_id}) to {_p}
        send colored "{@p}&d%{-forge::%{_id}%::name}%&f을(를) 얻었어요!" to {_p}
    else if {_k} = 6:
        set {_id} to random element out of ("dragon_greatsword" and "dragon_bow")
        give fResult({_id}) to {_p}
        broadcast colored "{@p}&e%{_p}%&f님이 적룡의 보물상자에서 &c%{-forge::%{_id}%::name}%&f을(를) 얻었습니다!"
    else:
        add 500000 to {_p}'s balance
        execute console command "starrpg give %{_p}% 뽑기권 5"
        broadcast colored "{@p}&e%{_p}%&f님이 적룡의 보물상자에서 &6&l대박&f을 터뜨렸습니다! (50만 원 + 뽑기권 5장)"

# 이그니스 처치 → 근처 플레이어 모두에게 상자
on death:
    victim is not a player
    uncolored display name of victim contains "적룡"
    loop all players in radius 40 of victim:
        give boxItem() to loop-player
        send title colored "&c&l🐉 적룡의 보물상자!" with subtitle colored "&f우클릭해서 열어 보세요" to loop-player for 3 seconds
        play sound "entity.ender_dragon.death" with volume 0.5 to loop-player

# 열기: 룰렛
on right click:
    uncolored name of player's tool is "🐉 적룡의 보물상자"
    cancel event
    {-box::busy::%uuid of player%} is not set
    set {-box::busy::%uuid of player%} to true
    remove 1 of player's tool from player's tool
    set {_res} to boxRoll()
    set {_gui} to chest inventory with 3 rows named "{@title}"
    loop 27 times:
        set slot (loop-value - 1) of {_gui} to black stained glass pane named " "
    set slot 4 of {_gui} to hopper named colored "&e▼"
    set slot 22 of {_gui} to hopper named colored "&e▲"
    loop 9 times:
        set {_strip::%loop-value%} to boxRoll()
    open {_gui} to player
    set {_spins} to 28
    loop {_spins} times:
        set {_i} to loop-value
        # 한 칸씩 밀기
        loop 8 times:
            set {_strip::%loop-value-2%} to {_strip::%loop-value-2 + 1%}
        if {_i} = {_spins} - 4:
            set {_strip::9} to {_res}
        else:
            set {_strip::9} to boxRoll()
        loop 9 times:
            set slot (8 + loop-value-2) of {_gui} to boxIcon({_strip::%loop-value-2%})
        play sound "block.note_block.hat" with pitch (0.8 + {_i} * 0.04) to player
        if {_i} < 14:
            wait 2 ticks
        else if {_i} < 22:
            wait 4 ticks
        else:
            wait 7 ticks
    # 가운데(슬롯 13) = 결과
    play sound "ui.toast.challenge_complete" to player
    set {_w} to boxIcon({_res})
    enchant {_w} with unbreaking 1
    set slot 13 of {_gui} to {_w}
    wait 1 second
    boxGive(player, {_res})
    delete {-box::busy::%uuid of player%}

on inventory click:
    name of event-inventory is "{@title}"
    cancel event

command /보물상자관리 [<text>]:
    permission: op
    trigger:
        set {_t} to (argument 1 ? "%player%") parsed as player
        give boxItem() to {_t}
        send "{@p}%{_t}%에게 보물상자 지급"
